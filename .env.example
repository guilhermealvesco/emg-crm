# ===== EMG CRM · copie para .env e preencha na VPS (nunca versionar o .env) =====
APP_ENV=prod
SECRET_KEY=troque-por-uma-chave-longa-aleatoria
PUBLIC_URL=https://crm.SEUDOMINIO.com.br
CRM_DOMAIN=crm.SEUDOMINIO.com.br
POSTGRES_PASSWORD=troque-esta-senha
TZ=America/Recife

# Senhas iniciais (só usadas pelo seed; depois cada um troca no painel)
ADMIN_EMAIL=guilherme@resolveco.com.br
OPERACAO_EMAIL=eduarda@emfinanceira.com
GUILHERME_PASSWORD=
EDUARDA_PASSWORD=

# APIBrasil (consultas por crédito)
APIBRASIL_ENABLED=true
APIBRASIL_HOMOLOG=true          # true = não gasta crédito. Mude para false quando validar.
APIBRASIL_TOKEN=
APIBRASIL_TIPO_PROTESTO_PJ=pessoa-juridica-protesto
APIBRASIL_TIPO_NEGATIVACAO_PJ=detalhamento-negativo
APIBRASIL_TIPO_CERTIDAO_PJ=certidao-conjunta-de-debitos-pessoa-juridica
APIBRASIL_TIPO_PROTESTO_PF=protesto-nacional-v2
APIBRASIL_TIPO_NEGATIVACAO_PF=spc-serasa
APIBRASIL_TIPO_DIVIDA_ATIVA_PF=divida-ativa

# Autentique
AUTENTIQUE_TOKEN=
AUTENTIQUE_SANDBOX=true         # true = documentos de teste, sem consumir créditos
AUTENTIQUE_WEBHOOK_SECRET=      # secret do endpoint cadastrado no painel do Autentique
AUTENTIQUE_VERIFICATION=LIVE    # LIVE = documento + selfie + prova de vida (MANUAL, UPLOAD, PF_FACIAL também aceitos)
AUTENTIQUE_SIGNER_EMG_EMAIL=    # opcional: e-mail da EMG para também assinar

# Regras e alertas (dias)
OWNERSHIP_DAYS=90
ALERTA_SEM_MOVIMENTO=7
ALERTA_BANCO_NAO_ENVIADO=3
ALERTA_SEM_FOLLOWUP=30
POSICAO_CLIENTE_DIAS=7
