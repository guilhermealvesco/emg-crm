# Domínio com HTTPS automático (Let's Encrypt). O Caddy tenta emitir o certificado até o DNS apontar para a VPS.
{$CRM_DOMAIN} {
    encode gzip
    reverse_proxy app:8000
}

# Acesso provisório pelo IP, sem HTTPS, enquanto o DNS não propaga.
http://{$CRM_IP} {
    encode gzip
    reverse_proxy app:8000
}
